<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Supabase bindings (order matters!) -->
    <Compile Include="Supabase/Types.fs" />
    <Compile Include="Supabase/Client.fs" />
    <Compile Include="Supabase/Storage.fs" />
    <Compile Include="Supabase/Workouts.fs" />
    <Compile Include="Supabase/Team.fs" />
    <Compile Include="Supabase/Admin.fs" />
    <Compile Include="Supabase/Auth.fs" />
    <!-- Utilities -->
    <Compile Include="Utils/DateHelpers.fs" />
    <!-- Offline Queue -->
    <Compile Include="offline/Types.fs" />
    <Compile Include="offline/Queue.fs" />
    <Compile Include="offline/NetworkStatus.fs" />
    <Compile Include="offline/Sync.fs" />
    <!-- Service Worker -->
    <Compile Include="sw/Registration.fs" />
    <!-- Components -->
    <Compile Include="Components/Layout.fs" />
    <Compile Include="Components/Calendar.fs" />
    <Compile Include="Components/WorkoutList.fs" />
    <Compile Include="Components/MonthlyStats.fs" />
    <Compile Include="Components/TeamMemberCard.fs" />
    <Compile Include="Components/PhotoUpload.fs" />
    <Compile Include="Components/PhotoGallery.fs" />
    <Compile Include="Components/OfflineIndicator.fs" />
    <!-- Admin UI components -->
    <Compile Include="admin/MemberList.fs" />
    <Compile Include="admin/MemberActions.fs" />
    <!-- Pages (depend on Components and Supabase) -->
    <Compile Include="Pages/Login.fs" />
    <Compile Include="Pages/Signup.fs" />
    <Compile Include="Pages/ForgotPassword.fs" />
    <Compile Include="Pages/ResetPassword.fs" />
    <Compile Include="Pages/ProgressView.fs" />
    <Compile Include="Pages/TeamView.fs" />
    <Compile Include="Pages/AdminPage.fs" />
    <Compile Include="Pages/Dashboard.fs" />
    <!-- Entry point last -->
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.17.0" />
    <PackageReference Include="Fable.Promise" Version="3.*" />
  </ItemGroup>
</Project>
